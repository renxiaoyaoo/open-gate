# Provider-derived configuration. Obtain these values only from an authorized
# provider integration; OpenGate does not generate them.
# Base URL used by the provider's mobile account and door APIs.
OPENGATE_PROVIDER_MOBILE_URL=
# Base URL used by the provider's application API.
OPENGATE_PROVIDER_APP_URL=
# Base URL used by the provider's gateway API.
OPENGATE_PROVIDER_GATEWAY_URL=
# Public application identifier expected by the provider.
OPENGATE_PROVIDER_APP_ID=
# Private application credential expected by the provider.
OPENGATE_PROVIDER_APP_SECRET=
# AES key used for provider-compatible mobile-number encryption.
OPENGATE_PROVIDER_MOBILE_AES_KEY=
# Key used to reproduce the provider's request signatures.
OPENGATE_PROVIDER_SIGNING_KEY=

# OpenGate-owned configuration. Generate this locally with
# `node ../deploy/cloudflare/rotate-session-key.mjs .env.local --yes`.
# A 32-byte key encoded as 64 hexadecimal characters; rotating it signs out all accounts.
OPENGATE_SESSION_ENCRYPTION_KEY=

# Node.js-only SQLite file. Use a persistent, writable path in production.
OPENGATE_DATABASE_PATH=./data/open-gate.sqlite

# Enables the account and door API. Keep disabled on a public origin unless an
# external access layer protects the deployment.
OPENGATE_API_ENABLED=0

# Optional provider client metadata. These defaults match the implementation
# when the variables are omitted; override only when the provider requires it.
OPENGATE_PROVIDER_APP_VERSION=5.3.0
OPENGATE_PROVIDER_APP_CHANNEL=honor
OPENGATE_PROVIDER_APP_VENDOR=Google

# Cloudflare deployment adapter settings. These are consumed only by
# `npm run cf:prepare` / `npm run cf:deploy` and are never sent to the provider.
# D1 database UUID assigned by Cloudflare; this is deployment-owned metadata.
OPENGATE_CF_DATABASE_ID=
# Existing D1 database name.
OPENGATE_CF_DATABASE_NAME=open-gate
# Optional hostname routed directly to the Worker, without a URL scheme or path.
OPENGATE_CF_CUSTOM_DOMAIN=
