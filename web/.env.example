# Provider compatibility is supplied as one schema-versioned JSON bundle. The
# bundle may be injected directly by a private runtime or fetched by the
# deployment script from a deployer-controlled HTTPS configuration service.
OPENHOME_PROVIDER_BUNDLE=
OPENHOME_PROVIDER_BUNDLE_URL=
OPENHOME_PROVIDER_BUNDLE_TOKEN=

# Generated by the deployment workflow when absent. Keep a recoverable private
# copy; changing it signs out stored accounts.
OPENHOME_SESSION_ENCRYPTION_KEY=

OPENHOME_DATABASE_PATH=./data/open-home.sqlite
OPENHOME_ACCESS_ENABLED=0

OPENHOME_CF_DATABASE_ID=
OPENHOME_CF_DATABASE_NAME=open-home
OPENHOME_CF_CUSTOM_DOMAIN=
